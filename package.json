{
  "name": "@anth0nycodes/fabric-history",
  "version": "1.1.1",
  "description": "A library built on top of fabric.js that allows for easy access to canvas history.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:it": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "publish:npm": "pnpm publish --access public"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "types": "dist/index.d.ts",
  "keywords": [
    "fabric",
    "fabric.js",
    "canvas history",
    "canvas undo",
    "canvas redo",
    "canvas"
  ],
  "author": "Anthony Hoang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anth0nycodes/fabric-history.git"
  },
  "bugs": {
    "url": "https://github.com/anth0nycodes/fabric-history/issues"
  },
  "homepage": "https://github.com/anth0nycodes/fabric-history#readme",
  "peerDependencies": {
    "fabric": ">=6.0.0 <8.0.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0"
    }
  },
  "devDependencies": {
    "@erase2d/fabric": "^1.2.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "canvas": "^3.2.1",
    "jsdom": "^29.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
